# Railway подставит DATABASE_URL и PORT сам, если добавить PostgreSQL
DATABASE_URL=postgres://portal:portal@localhost:5432/portal
NODE_ENV=production
# Администратор: пароль из ADMIN_PASSWORD применяется при каждом запуске (после первого входа переменную можно убрать)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=придумайте-надёжный-пароль
# Куда складывать селфи (на Railway — подключите Volume и укажите его путь)
UPLOAD_DIR=./uploads
# Для отладки ошибок API в консоль
# DEBUG_ERRORS=1
